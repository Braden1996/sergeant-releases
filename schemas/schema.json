                "description": "Forbidden transitive tags, `pkg:<name>`, or runtime capabilities (`capability:fs|net|process|host|io|load-effect|dynamic-import`).",
                "items": {
                  "type": "string"
                }
              },
              "forbidExternal": {
                "type": "object",
