                "additionalProperties": {
                  "type": "string"
                }
              },
              "allowTypeOnly": {
                "type": "boolean",
                "description": "When true, `import type` is exempt from this rule's direct checks."
              },
              "maxExternalDeps": {
                "type": "integer",
                "minimum": 0,
                "description": "Maximum number of third-party runtime dependencies allowed."
              }
            }
