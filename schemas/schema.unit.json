{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sergeant Package Configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^@[a-z0-9._-]+/[a-z0-9._-]+$",
      "description": "Full scoped package name (`@namespace/pkg`)."
    },
    "kind": {
      "type": "string",
      "enum": [
        "bun:lib",
        "bun:service",
        "ts:pure",
        "ts:dom",
        "ts:node",
        "ts:native",
        "node:service",
        "rust:lib",
        "rust:bin"
      ],
      "description": "Plugin-provided package kind (`<plugin>:<kind>`)."
    },
    "extends": {
      "description": "Named root preset(s) or relative preset path(s).",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Production workspace `@namespace/pkg` dependencies."
    },
    "devDependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Test-only workspace `@namespace/pkg` dependencies."
    },
    "needs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "private": {
      "type": "boolean"
    },
    "platform": {
      "type": "string"
    },
    "visibility": {
      "description": "Who may import this unit: `public`, `subtree` (same parent folder), `internal` (none), or an explicit array of allowed unit names/selectors.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "public",
            "subtree",
            "internal"
          ]
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowDeps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "description": "Package-level boundary overrides for this unit.",
      "properties": {
        "allow": {
          "type": "array",
          "description": "Extra workspace selectors this unit may import.",
          "items": {
            "type": "string"
          }
        },
        "forbid": {
          "type": "array",
          "description": "Direct targets forbidden to this unit.",
          "items": {
            "type": "string"
          }
        },
        "forbidTransitive": {
          "type": "array",
          "description": "Transitive tags, packages, or capabilities forbidden to this unit.",
          "items": {
            "type": "string"
          }
        },
        "forbidExternal": {
          "type": "object",
          "description": "Banned external packages mapped to replacement hints.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "allowTypeOnly": {
          "type": "boolean",
          "description": "Exempt `import type` on this unit's boundary checks."
        },
        "maxExternalDeps": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum third-party runtime dependencies allowed in this unit."
        }
      }
    },
    "uncached": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entry": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": [
            "esm",
            "cjs"
          ]
        },
        "external": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "typescript": {
      "type": "object",
      "description": "Per-unit TypeScript compilerOptions overrides."
    },
    "check": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "description": "Short summary shown by `sgt tasks`."
          },
          "run": {
            "description": "Command to execute (shell string or argv array). Supports ${root}, ${unit}, ${name}, ${out}, ${exe}, and ${<unit>:build} tokens.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            ]
          },
          "inputs": {
            "type": "array",
            "description": "Input file globs hashed into the task cache key (prefix `!` to negate).",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "description": "Output paths captured from the task into the content cache.",
            "items": {
              "type": "string"
            }
          },
          "dependsOn": {
            "type": "array",
            "description": "Prerequisite tasks (`^task`, `<unit>:<task>`, `build:<unit>`, `check`, `test`, or sibling task name).",
            "items": {
              "type": "string"
            }
          },
          "into": {
            "type": "string",
            "description": "Directory where generated outputs are materialized before checks, tests, and builds."
          },
          "env": {
            "description": "Environment variables set for the task (array of KEY=VALUE strings or object map).",
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            ]
          },
          "passThroughEnv": {
            "type": "array",
            "description": "Host environment variables forwarded without being hashed into the cache key.",
            "items": {
              "type": "string"
            }
          },
          "tools": {
            "type": "array",
            "description": "External tools required by this task (resolved and hashed into the cache key).",
            "items": {
              "type": "string"
            }
          },
          "cache": {
            "type": "boolean",
            "description": "Whether to cache task results (defaults to true for isolated tasks, false for live/watch)."
          },
          "check": {
            "type": "boolean",
            "description": "When true, runs this task automatically as a verification gate during `sgt check`."
          },
          "mode": {
            "type": "string",
            "enum": [
              "isolated",
              "live",
              "watch"
            ],
            "description": "Execution mode: `isolated` (hermetic snapshot, cached), `live` (workspace cwd, uncached by default), or `watch` (continuous long-running process)."
          },
          "lane": {
            "type": "string",
            "enum": [
              "unit",
              "browser",
              "integration",
              "e2e"
            ],
            "description": "Test lane that owns this task when running `sgt test --type <lane>`."
          }
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "description": "Short summary shown by `sgt tasks`."
          },
          "run": {
            "description": "Command to execute (shell string or argv array). Supports ${root}, ${unit}, ${name}, ${out}, ${exe}, and ${<unit>:build} tokens.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            ]
          },
          "inputs": {
            "type": "array",
            "description": "Input file globs hashed into the task cache key (prefix `!` to negate).",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "description": "Output paths captured from the task into the content cache.",
            "items": {
              "type": "string"
            }
          },
          "dependsOn": {
            "type": "array",
            "description": "Prerequisite tasks (`^task`, `<unit>:<task>`, `build:<unit>`, `check`, `test`, or sibling task name).",
            "items": {
              "type": "string"
            }
          },
          "into": {
            "type": "string",
            "description": "Directory where generated outputs are materialized before checks, tests, and builds."
          },
          "env": {
            "description": "Environment variables set for the task (array of KEY=VALUE strings or object map).",
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            ]
          },
          "passThroughEnv": {
            "type": "array",
            "description": "Host environment variables forwarded without being hashed into the cache key.",
            "items": {
              "type": "string"
            }
          },
          "tools": {
            "type": "array",
            "description": "External tools required by this task (resolved and hashed into the cache key).",
            "items": {
              "type": "string"
            }
          },
          "cache": {
            "type": "boolean",
            "description": "Whether to cache task results (defaults to true for isolated tasks, false for live/watch)."
          },
          "check": {
            "type": "boolean",
            "description": "When true, runs this task automatically as a verification gate during `sgt check`."
          },
          "mode": {
            "type": "string",
            "enum": [
              "isolated",
              "live",
              "watch"
            ],
            "description": "Execution mode: `isolated` (hermetic snapshot, cached), `live` (workspace cwd, uncached by default), or `watch` (continuous long-running process)."
          },
          "lane": {
            "type": "string",
            "enum": [
              "unit",
              "browser",
              "integration",
              "e2e"
            ],
            "description": "Test lane that owns this task when running `sgt test --type <lane>`."
          }
        }
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "description": "Short summary shown by `sgt tasks`."
          },
          "run": {
            "description": "Command to execute (shell string or argv array). Supports ${root}, ${unit}, ${name}, ${out}, ${exe}, and ${<unit>:build} tokens.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            ]
          },
          "inputs": {
            "type": "array",
            "description": "Input file globs hashed into the task cache key (prefix `!` to negate).",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "description": "Output paths captured from the task into the content cache.",
            "items": {
              "type": "string"
            }
          },
          "dependsOn": {
            "type": "array",
            "description": "Prerequisite tasks (`^task`, `<unit>:<task>`, `build:<unit>`, `check`, `test`, or sibling task name).",
            "items": {
              "type": "string"
            }
          },
          "into": {
            "type": "string",
            "description": "Directory where generated outputs are materialized before checks, tests, and builds."
          },
          "env": {
            "description": "Environment variables set for the task (array of KEY=VALUE strings or object map).",
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            ]
          },
          "passThroughEnv": {
            "type": "array",
            "description": "Host environment variables forwarded without being hashed into the cache key.",
            "items": {
              "type": "string"
            }
          },
          "tools": {
            "type": "array",
            "description": "External tools required by this task (resolved and hashed into the cache key).",
            "items": {
              "type": "string"
            }
          },
          "cache": {
            "type": "boolean",
            "description": "Whether to cache task results (defaults to true for isolated tasks, false for live/watch)."
          },
          "check": {
            "type": "boolean",
            "description": "When true, runs this task automatically as a verification gate during `sgt check`."
          },
          "mode": {
            "type": "string",
            "enum": [
              "isolated",
              "live",
              "watch"
            ],
            "description": "Execution mode: `isolated` (hermetic snapshot, cached), `live` (workspace cwd, uncached by default), or `watch` (continuous long-running process)."
          },
          "lane": {
            "type": "string",
            "enum": [
              "unit",
              "browser",
              "integration",
              "e2e"
            ],
            "description": "Test lane that owns this task when running `sgt test --type <lane>`."
          }
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "setup": {
          "type": "string",
          "description": "Module loaded before each test file."
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uncached": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "programs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reads": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "network": {
          "type": "boolean"
        },
        "loopback": {
          "type": "boolean"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
